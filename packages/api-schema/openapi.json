{
  "openapi": "3.0.0",
  "paths": {
    "/v1/app/config": {
      "get": {
        "operationId": "AppConfig_config",
        "parameters": [
          {
            "name": "x-company",
            "required": false,
            "in": "header",
            "description": "Company slug; optional while there is one company",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppConfigResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error (see `code`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            }
          }
        },
        "tags": [
          "app"
        ]
      }
    },
    "/v1/auth/mobile/sign-in": {
      "post": {
        "operationId": "Auth_signInMobile",
        "parameters": [],
        "requestBody": {
          "required": true,
