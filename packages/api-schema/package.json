{
  "name": "@clockin/api-schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./openapi.json": "./openapi.json"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.ts && prettier --write src/schema.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@clockin/tsconfig": "workspace:*",
    "openapi-typescript": "^7.13.0"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  }
}
